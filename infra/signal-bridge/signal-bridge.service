[Unit]
Description=pwn4g3 signal bridge (localhost HTTP -> signal-cli send)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=signalbridge
Group=signalbridge
WorkingDirectory=/opt/signal-bridge
EnvironmentFile=-/opt/signal-bridge/bridge.env
ExecStart=/usr/bin/python3 /opt/signal-bridge/bridge.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/signal-bridge

[Install]
WantedBy=multi-user.target
