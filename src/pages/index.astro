---
import ArchitectureMatrix from '../components/ArchitectureMatrix.tsx';
import ArchitectureMatrixVue from '../components/ArchitectureMatrix.vue';
import LiveStatus from '../components/LiveStatus.solid.tsx';
import Terminal from '../components/Terminal.solid.tsx';
import Signal from '../components/Signal.svelte';
import '../styles/global.css';

const projects = [
	{ name: 'KananOS / United Distribution', type: 'Production', tagline: 'Multi-tenant B2B e-commerce wholesale platform', stack: ['Next.js', 'TypeScript', 'Vercel'], image: '/projects/united-distro.png', url: 'https://united-distro.vercel.app/united', repo: 'https://github.com/geekhaus314/kanan-e', detail: 'Production multi-tenant storefront infrastructure with catalogs, branded storefronts, checkout, and deployment.' },
	{ name: 'Brian Ivie Hair', type: 'Client', tagline: 'Production website + commerce experience', stack: ['Next.js', 'MDX', 'Cloudflare Pages'], image: '/projects/brian-home.png', url: 'https://www.myhairloss.com', repo: 'https://github.com/geekhaus314/myhairloss-stl', detail: 'Production site with service pages, shop functionality, admin tooling, custom domains, and automated deployment.' },
	{ name: 'AgentOS', type: 'Platform', tagline: 'Vertical AI revenue infrastructure', stack: ['Java', 'Gradle', 'AI Agents'], repo: 'https://github.com/geekhaus314/agentos', detail: 'Multi-tenant workflow infrastructure with vertical modules, white-label deployment, agent orchestration, authorization, and audit logging.' },
	{ name: 'ProofShelf', type: 'SaaS', tagline: 'Search-heavy full-stack SaaS architecture', stack: ['Next.js', 'PostgreSQL', 'pgvector', 'Redis'], repo: 'https://github.com/geekhaus314', detail: 'Dockerized application and worker services with semantic search, caching, authentication, and a pnpm monorepo.' },
	{ name: 'Obsidian Platform', type: 'Security', tagline: 'Bug bounty intelligence + attack surface management', stack: ['Go', 'Recon', 'ASM'], repo: 'https://github.com/3m0h4ck3r/obsidian-platform', detail: 'Security research platform focused on automated reconnaissance, scope monitoring, target profiling, and attack-surface intelligence.' },
	{ name: 'bb-suite', type: 'Security', tagline: 'Modular Python reconnaissance toolkit', stack: ['Python', 'CLI', 'Security'], repo: 'https://github.com/geekhaus314', detail: 'Recon tooling with configuration, structured data pipelines, scoped targets, and modular security workflows.' },
	{ name: 'Viper-Web3', type: 'Security', tagline: 'Smart-contract security toolkit', stack: ['Solidity', 'Python', 'Web3'], repo: 'https://github.com/geekhaus314/Viper-Web3', detail: 'Security tooling for Solidity and Web3 auditing and research.' },
	{ name: 'NightAnvil', type: 'Automation', tagline: 'Freelancer business automation toolkit', stack: ['Python', 'Flask', 'Stripe', 'PostgreSQL'], repo: 'https://github.com/3m0h4ck3r/nightanvil', detail: 'Freelancer tooling combining AI-assisted generation, invoices, payment workflows, secure sessions, and CI/CD.' },
	{ name: 'Vercel AI Gateway Demo', type: 'AI', tagline: 'Provider routing + caching patterns', stack: ['TypeScript', 'Vercel', 'AI'], repo: 'https://github.com/geekhaus314/vercel-ai-gateway-demo', detail: 'Provider abstraction, routing, and caching patterns for LLM-backed applications.' },
	{ name: 'Angie Viefhaus Photography', type: 'Client', tagline: 'Editorial wildlife photography portfolio', stack: ['React', 'TypeScript', 'Tailwind', 'Cloudflare'], image: '/projects/angie-site.png', url: 'https://angie-viefhaus.pages.dev', repo: 'https://github.com/geekhaus314/angie-viefhaus', detail: 'Editorial portfolio with gallery, manifesto, lightbox, responsive presentation, and Cloudflare deployment.' },
	{ name: 'Compass', type: 'Product', tagline: 'A quiet instrument for the human psyche', stack: ['React', 'Vite', 'JavaScript', 'Local storage'], image: '/projects/compass.png', repo: 'https://github.com/geekhaus314/Compass-Psychadelic-Trip-Journal', detail: 'A private browser-local journaling application with Journal, Sessions, Navigate, Shelf, and Data tabs. Entries stay in the browser and can be backed up from the Data tab.' }
	, { name: 'Framework Lab', type: 'Platform', tagline: 'Astro shell with React, Vue, Solid, Svelte, Next, and Nuxt surfaces', stack: ['Astro', 'React', 'Vue', 'Solid', 'Svelte', 'Next.js', 'Nuxt'], repo: 'https://github.com/geekhaus314/pwn4g3-portfolio', detail: 'A deliberately compartmentalized frontend lab: Astro owns the public shell while each framework owns a focused interactive or application boundary.' }
	, { name: 'Polyglot Services', type: 'Platform', tagline: 'Matching backend contracts across three runtimes', stack: ['Rust', 'Go', 'Ruby', 'HTTP', 'Health checks'], repo: 'https://github.com/geekhaus314/pwn4g3-portfolio/tree/main/apps/services', detail: 'Small, runnable services in Rust, Go, and Ruby that expose the same health endpoint and response shape for comparing operational tradeoffs.' }
];

const betaProjects = [
	{ name: 'pwn4g3-web', status: 'Beta / active build', detail: 'Next.js product surface under active development. This is a real local project and belongs in the testing queue.', repo: 'https://github.com/geekhaus314/pwn4g3-web' },
	{ name: 'pwn4g3-api', status: 'Beta / service', detail: 'Go API and streaming telemetry component for testing real-time service boundaries.', repo: 'https://github.com/geekhaus314/pwn4g3-api' },
	{ name: 'pwn4g3-rebuild', status: 'Beta / redesign', detail: 'Local redesign project for iterating on the portfolio surface before release.', repo: 'https://github.com/geekhaus314/pwn4g3-rebuild' }
];

const capabilities = [
	['01', 'Web Applications', 'Fast, responsive products built with modern React and Next.js architectures.'],
	['02', 'APIs & Backend', 'Typed APIs, middleware, workers, integrations, databases, and service architecture.'],
	['03', 'Automation & AI', 'Workflow automation and AI-enabled systems designed around real business processes.'],
	['04', 'Security Engineering', 'Application hardening, reconnaissance tooling, security research, and offensive-security engineering.'],
	['05', 'Infrastructure', 'Cloud deployment, containers, DNS, CI/CD, edge infrastructure, and production operations.'],
	['06', 'Technical Redesign', 'Rebuilds that improve UX, architecture, maintainability, and technical credibility at once.']
];

const stack = ['React', 'Next.js', 'TypeScript', 'JavaScript', 'Node.js', 'Python', 'Java', 'Go', 'Rust', 'Ruby', 'Solidity', 'PostgreSQL', 'Redis', 'Docker', 'Cloudflare', 'Vercel', 'Git', 'Bash', 'Tailwind', 'AI / LLM APIs'];
const filters = ['All', 'Production', 'Security', 'Platform', 'SaaS', 'Client', 'Automation', 'AI', 'Product'];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content="pwn4g3 — software and security engineering by Jake Viefhaus. Web applications, APIs, automation, AI systems, infrastructure, and security engineering." />
		<meta name="theme-color" content="#050608" />
		<meta name="author" content="Jake Viefhaus" />
		<meta name="robots" content="index, follow, max-image-preview:large" />
		<link rel="canonical" href="https://pwn4g3.pages.dev/" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500&family=IBM+Plex+Mono:wght@400;500;600&family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600&display=swap" rel="stylesheet" />
		<meta property="og:type" content="website" />
		<meta property="og:title" content="pwn4g3 — Software + Security Engineering" />
		<meta property="og:description" content="Software, automation, AI systems, infrastructure, and security engineering." />
		<meta property="og:url" content="https://pwn4g3.pages.dev" />
		<link rel="icon" href="/favicon.svg" />
		<script type="application/ld+json" set:html={JSON.stringify({
			'@context': 'https://schema.org',
			'@type': 'ProfilePage',
			name: 'pwn4g3 — Jake Viefhaus',
			url: 'https://pwn4g3.pages.dev/',
			mainEntity: {
				'@type': 'Person',
				name: 'Jake Viefhaus',
				alternateName: ['pwn4g3', 'geekhaus314'],
				jobTitle: 'Full-stack Developer',
				email: 'mailto:geekhaus314@proton.me',
				address: { '@type': 'PostalAddress', addressLocality: 'Florissant', addressRegion: 'MO', addressCountry: 'US' },
				sameAs: ['https://github.com/geekhaus314', 'https://gitlab.com/geekhaus314', 'https://www.instagram.com/pwn4g3.io']
			}
		})}></script>
		<title>pwn4g3 — Software + Security Engineering</title>
	</head>
	<body>
		<div class="site-shell">
			<header class="nav">
				<a class="brand" href="#top"><span>pwn</span>4g3</a>
				<nav aria-label="Primary navigation">{['work', 'capabilities', 'security', 'stack', 'contact'].map((item) => <a href={`#${item}`}>{item}</a>)}</nav>
				<a class="nav-cta" href="#contact">Start a project <span aria-hidden="true">↗</span></a>
			</header>

			<main id="top">
				<section class="hero">
					<div class="hero-copy">
						<div class="eyebrow"><i aria-hidden="true"></i> SOFTWARE + SECURITY ENGINEERING</div>
						<h1>Software with<br /><em>teeth.</em></h1>
						<p class="hero-lede">I make useful systems for the messy middle: where product decisions meet infrastructure, automation, and the ways people actually break things.</p>
						<div class="hero-actions"><a class="button primary" href="#work">Explore the work <span aria-hidden="true">↓</span></a><a class="button ghost" href="https://github.com/geekhaus314" target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a></div>
						<div class="hero-meta"><span>ST. LOUIS / USA</span><span>SELECT PROJECTS</span></div>
					</div>
					<div class="hero-visual" aria-label="Interactive pwn4g3 command line">
						<div class="terminal"><div class="terminal-bar"><span></span><span></span><span></span><b>pwn4g3://cli</b></div><Terminal client:load /></div>
						<div class="orbit orbit-a" aria-hidden="true"></div><div class="orbit orbit-b" aria-hidden="true"></div><div class="hero-code" aria-hidden="true">&lt;engineer<br />/&gt;</div>
					</div>
				</section>

				<section id="work" class="section">
					<div class="section-heading"><div><span class="section-kicker">01 / FIELD NOTES</span><h2>Receipts, not <em>claims.</em></h2></div><p>Some shipped. Some are still sharp on the workbench. Every project here exists because a real constraint made a better engineer of me.</p></div>
					<div class="filters" role="group" aria-label="Filter projects">{filters.map((filter, index) => <button class:list={{ active: index === 0 }} data-filter={filter}>{filter}</button>)}</div>
					<div class="project-grid">
						{projects.map((project, index) => <article class:list={['project-card', { featured: index === 0 }]} data-type={project.type} data-project={index} data-name={project.name} data-tagline={project.tagline} data-detail={project.detail} data-stack={project.stack.join('|')} data-url={project.url ?? ''} data-image={project.image ?? ''} data-repo={project.repo} tabindex="0" role="button" aria-label={`View ${project.name}`}>
							<div class="project-media">{project.image ? <img src={project.image} alt={`${project.name} screenshot`} loading={index > 1 ? 'lazy' : 'eager'} /> : <div class="project-placeholder"><span>{project.type} / SCREENSHOT PENDING</span><strong>{project.name}</strong><i aria-hidden="true">↗</i></div>}<div class="project-index">{String(index + 1).padStart(2, '0')}</div></div>
							<div class="project-info"><div><span class="project-type">{project.type}</span><h3>{project.name}</h3><p>{project.tagline}</p></div><span class="arrow" aria-hidden="true">↗</span></div>
						</article>)}
					</div>
				</section>

				<section id="beta" class="section beta-workbench">
					<div class="section-heading"><div><span class="section-kicker">01A / PRIVATE WORKBENCH</span><h2>Not ready for a <em>teaser.</em></h2></div><p>Unreleased projects get a visible place without invented screenshots or premature claims. This is where testing access, notes, and release status can live when each beta is ready.</p></div>
					<div class="beta-grid">{betaProjects.map((project, index) => <article class="beta-card"><span class="beta-index">BETA / {String(index + 1).padStart(2, '0')}</span><span class="project-type">{project.status}</span><h3>{project.name}</h3><p>{project.detail}</p><a class="beta-link" href={project.repo} target="_blank" rel="noreferrer">Open repository ↗</a></article>)}</div>
				</section>

				<section id="capabilities" class="section capabilities"><div class="section-heading"><div><span class="section-kicker">02 / HOW I WORK</span><h2>More than <em>screens.</em></h2></div><p>A good interface is the visible edge of a much larger decision: data shape, failure mode, deployment model, and who has to live with it later.</p></div><div class="cap-grid">{capabilities.map(([number, title, description]) => <div class="cap"><span>{number}</span><h3>{title}</h3><p>{description}</p></div>)}</div></section>

				<section id="security" class="section security"><div class="security-panel"><div class="security-copy"><span class="section-kicker">03 / THREAT MODEL</span><h2>Assume it<br /><em>will break.</em></h2><p>I look for the interesting failure before it becomes the expensive one. Security is a design constraint, an engineering discipline, and a habit of asking one more uncomfortable question.</p><div class="security-list"><span>01 / What is exposed?</span><span>02 / What can be automated?</span><span>03 / What happens when trust fails?</span><span>04 / What will the logs tell us?</span><span>05 / Can the next person operate it?</span></div></div><div class="security-visual"><div class="radar"><i></i><i></i><i></i><i></i><b>STAY<br />CURIOUS</b></div><div class="scanline"></div></div></div></section>

				<section id="stack" class="section"><div class="section-heading"><div><span class="section-kicker">04 / THE BENCH</span><h2>Tools I reach for <em>often.</em></h2></div><p>Tools are instruments, not personality traits. The interesting part is knowing when to stop adding them.</p></div><div class="stack-cloud">{stack.map((item) => <span>{item}</span>)}</div></section>
				<section id="architecture" class="section architecture"><div class="section-heading"><div><span class="section-kicker">05 / SYSTEM DESIGN</span><h2>Compartmentalized by <em>intent.</em></h2></div><p>Each tool has a boundary and a job. Islands stay small, services stay replaceable, and the public surface stays fast.</p></div><div class="architecture-grid"><div><ArchitectureMatrix client:load /></div><div><ArchitectureMatrixVue client:visible /></div><div class="architecture-status"><LiveStatus client:load /><Signal client:load /></div></div></section>

				<section class="manifesto"><div class="manifesto-mark">P4 / NOTE 001</div><blockquote>“Make it <em>legible</em> before you make it clever.”</blockquote><p>— written in the margin, then tested in production</p></section>
				<section id="contact" class="section contact"><div><span class="section-kicker">06 / START SOMETHING</span><h2>Have a problem<br />worth <em>building?</em></h2><p>Tell me what you're trying to accomplish. We'll figure out the architecture from there.</p></div><div class="contact-actions"><a class="button primary big" href="mailto:geekhaus314@proton.me">geekhaus314@proton.me <span aria-hidden="true">↗</span></a><a class="contact-link" href="https://github.com/geekhaus314" target="_blank" rel="noreferrer">github.com/geekhaus314 <span aria-hidden="true">↗</span></a></div></section>
			</main>
			<footer><span class="brand"><span>pwn</span>4g3</span><span>Software + Security Engineering</span><span>© {new Date().getFullYear()} Jake Viefhaus</span></footer>
		</div>

		<dialog class="modal" id="project-dialog"><button class="modal-close" aria-label="Close project details">ESC / CLOSE ×</button><span class="section-kicker" id="modal-type"></span><h2 id="modal-title"></h2><p class="modal-tagline" id="modal-tagline"></p><img id="modal-image" alt="" /><p id="modal-detail"></p><div class="tags" id="modal-tags"></div><div class="modal-actions" id="modal-actions"></div></dialog>

		<script src="../scripts/portfolio.ts"></script>
	</body>
</html>
