{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "pwn4g3-notify",
  "main": "src/index.ts",
  // Project convention is 2026-08-26 across all workers (binding-uniformity);
  // workers-best-practices suggests today for new workers — flagged, sticking
  // with convention like #28 did.
  "compatibility_date": "2026-08-26",
  "workers_dev": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pwn4g3-db",
      "database_id": "797bd506-7e63-4786-b2e7-7b94884211c0",
      "migrations_dir": "../migrations"
    }
  ],
  "services": [{ "binding": "TELEMETRY_SERVICE", "service": "pwn4g3-telemetry" }],
  // KV targets (per the #39 row) arrive with #43: the console needs dynamic
  // per-channel targets, and creating the namespace needs authed creds.
  // v1 reads static targets from secrets/vars so CI stays green.
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
