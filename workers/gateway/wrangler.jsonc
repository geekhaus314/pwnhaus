{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "pwn4g3",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-26",
  "workers_dev": true,
  "vars": {
    "PWN4G3_ASSETS_URL": "https://pwn4g3.geekhaus314.workers.dev/assets"
  },
  "services": [
    { "binding": "HEALTH_SERVICE", "service": "pwn4g3-health" },
    { "binding": "COMPONENTS_SERVICE", "service": "pwn4g3-components" },
    { "binding": "VIPER_SERVICE", "service": "pwn4g3-viper" },
    { "binding": "ASSETS_SERVICE", "service": "pwn4g3-assets" },
    { "binding": "BOOKING_SERVICE", "service": "pwn4g3-booking" },
    { "binding": "NOTIFY_SERVICE", "service": "pwn4g3-notify" },
    { "binding": "DISCORD_SERVICE", "service": "pwn4g3-discord" },
    { "binding": "REDDIT_SERVICE", "service": "pwn4g3-reddit" },
    { "binding": "ADMIN_SERVICE", "service": "pwn4g3-admin" },
    { "binding": "PAYMENTS_SERVICE", "service": "pwn4g3-payments" },
    { "binding": "HIVEMIND_SERVICE", "service": "pwn4g3-hivemind" },
    { "binding": "TELEMETRY_SERVICE", "service": "pwn4g3-telemetry" }
  ]
}